{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sondergraph",
  "version": "0.0.1",
  "identifier": "app.sondergraph.desktop",
  "build": {
    "frontendDist": "./placeholder-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sondergraph-server"
    ],
    "shortDescription": "Your contacts, mapped.",
    "longDescription": "sondergraph gathers your contacts from the social platforms and exports you already have into a directory you own, then shows them as a single graph.",
    "resources": {
      "binaries/wwwroot/**/*": "."
    }
  }
}
