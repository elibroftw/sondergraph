<Project>

  <!-- Central build configuration. Every project inherits this. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat warnings as errors so the layering rules and analyzer findings
         are enforced, not merely reported. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic, reviewable builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.0.1</Version>
    <Authors>Elijah Lopez</Authors>
    <Product>sondergraph</Product>
    <Description>Map the people in your life into a graph you own.</Description>
    <RepositoryType>git</RepositoryType>

    <!-- "or-later" because the LICENSE file's notice says what the FSF recommends: either
         version 3 of the License, or (at your option) any later version. Stated as the SPDX
         expression so NuGet and other tooling can read it without parsing prose. -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Elijah Lopez</Copyright>
  </PropertyGroup>

</Project>
